# this service replaces ovn-controller service from the upstream ubuntu build in the custom pf9 OVN build
[Unit]
Description=OVN controller daemon
After=network.target openvswitch-switch.service

[Service]
Type=forking
Restart=on-failure
EnvironmentFile=-/etc/default/ovn-host
ExecStart=/usr/share/ovn/scripts/ovn-ctl --no-monitor --ovn-manage-ovsdb=no start_controller $OVN_CTL_OPTS
# --restart tells ovn-controller to skip its exit-time cleanup: the Chassis row,
# Port_Binding chassis/encap columns and br-int tunnel ports are all left intact,
# so a stop/start cycle is invisible to the rest of the deployment.  Without it
# every restart deletes this chassis from the SB DB, unbinds all its ports and
# drops every VM on the host.  Full cleanup on real removal is done by the
# ovn-host prerm instead.
ExecStop=/usr/share/ovn/scripts/ovn-ctl --no-monitor stop_controller --restart

[Install]
WantedBy=multi-user.target