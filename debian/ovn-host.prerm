#!/bin/sh
# prerm script for ovn-host
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing' <conflicting-package>
#          <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    remove|deconfigure)
        # ovn-host.service stops ovn-controller with --restart, which
        # deliberately preserves this chassis' state in the southbound DB so
        # that upgrades do not disturb the data plane.  When the package is
        # actually going away that state would be left behind as garbage, so
        # stop once without --restart to run the full cleanup: delete the
        # Chassis/Chassis_Private rows, clear the chassis and encap columns on
        # our Port_Bindings and remove the tunnel ports from br-int.
        if [ -x /usr/share/ovn/scripts/ovn-ctl ]; then
            /usr/share/ovn/scripts/ovn-ctl --no-monitor stop_controller || true
        fi
        ;;

    upgrade|failed-upgrade)
        # Nothing to do: the graceful stop/start is handled by the service.
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
